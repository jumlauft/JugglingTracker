<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        Swipe-to-dismiss is off: on the tracking screens a swipe is BACK, and
        BACK must open the discard prompt rather than close the activity and
        lose the session. The app handles the swipe itself (ui/BackSwipe.kt).
    -->
    <style name="Theme.JugglingTrackerWear" parent="@android:style/Theme.DeviceDefault">
        <item name="android:windowSwipeToDismiss">false</item>
        <item name="android:windowBackground">@android:color/black</item>
    </style>
</resources>
