<iq-project>
    <id>com.jugglingtracker.imustream</id>
    <vendor>JugglingTracker</vendor>
    <name>JugglingTracker IMU Stream</name>
    <description>Streams Forerunner 245 IMU data to an Android companion app.</description>
    <version>1.0.0</version>
    <type>app</type>
    <sdk-version>4.3</sdk-version>
    <supported-devices>
        <device>forerunner245</device>
    </supported-devices>
    <source-folder>source</source-folder>
    <resources-folder>resources</resources-folder>
    <output-folder>build</output-folder>
    <permissions>
        <permission>communications</permission>
    </permissions>
</iq-project>
