{
  "name": "Runs are counted live and folded into the session stats",
  "requirements": [
    "JUG-1"
  ],
  "steps": [
    {
      "press": "start"
    },
    {
      "press": "start"
    },
    {
      "warmup": true
    },
    {
      "expect": {
        "runActive": false,
        "runs": 0
      }
    },
    {
      "catches": 3
    },
    {
      "expect": {
        "runActive": true,
        "count": 3
      }
    },
    {
      "idle": 60
    },
    {
      "expect": {
        "runActive": false,
        "count": 0,
        "previous": 3,
        "runs": 1,
        "max": 3
      }
    },
    {
      "catches": 5
    },
    {
      "idle": 60
    },
    {
      "expect": {
        "runs": 2,
        "previous": 5,
        "max": 5
      }
    }
  ]
}
