// Start-up flow opens Juggle mode with the chosen ball count (APP-1, APP-2, APP-3, APP-4)
(:test)
function scenario_app_startup_juggle(logger as Logger) as Boolean {
    var r = new ScenarioRunner(1700000000);
    r.expect({ "screen" => "modeSelect", "recordMode" => false });
    r.press("down");
    r.expect({ "recordMode" => true });
    r.press("up");
    r.expect({ "recordMode" => false });
    r.press("start");
    r.expect({ "screen" => "ballSelect", "mode" => "juggle", "balls" => 3 });
    r.press("up");
    r.press("up");
    r.expect({ "balls" => 5 });
    r.press("down");
    r.expect({ "balls" => 4 });
    r.press("start");
    r.expect({ "screen" => "tracker", "balls" => 4, "runs" => 0, "runActive" => false, "menu" => null });
    return r.passed(logger);
}

