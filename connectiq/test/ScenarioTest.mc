// START walks a run through recording, labelling and syncing, and the ack ends it (REC-1, REC-3, REC-5, REC-8)
(:test)
function scenario_rec_record_label_sync(logger as Logger) as Boolean {
    var r = new ScenarioRunner(1700000000);
    r.press("up");
    r.press("start");
    r.press("start");
    r.expect({ "phase" => "idle" });
    r.press("start");
    r.expect({ "phase" => "recording" });
    r.warmup();
    r.catches(4);
    r.press("start");
    r.expect({ "phase" => "labeling", "detected" => 4, "label" => 4 });
    r.press("up");
    r.expect({ "label" => 5 });
    r.press("start");
    r.expect({ "phase" => "syncing", "firstSent" => { "type" => "rec_start", "id" => 1700000000, "balls" => 3, "catches" => 5, "detected" => 4, "sampleRate" => 25, "countMode" => "watch_hand" } });
    r.deliverAll();
    r.expect({ "phase" => "syncing", "sentTypes" => ["rec_start", "rec_chunk", "rec_end"], "lastSent" => { "type" => "rec_end", "id" => 1700000000 } });
    r.phone({ "type" => "ack", "timestamp" => 1699999995 });
    r.expect({ "phase" => "syncing", "runsCompleted" => 0 });
    r.phone({ "type" => "ack", "timestamp" => 1700000000 });
    r.expect({ "phase" => "idle", "runsCompleted" => 1 });
    return r.passed(logger);
}

// A failed send offers Retry, Skip or Quit; Skip loses the run without counting it (REC-6, REC-10)
(:test)
function scenario_rec_send_failure(logger as Logger) as Boolean {
    var r = new ScenarioRunner(1700000000);
    r.press("up");
    r.press("start");
    r.press("start");
    r.press("start");
    r.warmup();
    r.catches(3);
    r.press("start");
    r.press("start");
    r.deliver(false);
    r.expect({ "menu" => "rec_sync", "menuTitle" => "send failed", "menuLabels" => ["Retry sync", "Skip (lose data)", "Quit"], "error" => "Sync failed" });
    r.select("sync_retry");
    r.wait(50);
    r.expect({ "sentTypes" => ["rec_start"], "sentCount" => 2 });
    r.deliver(false);
    r.select("sync_skip");
    r.expect({ "phase" => "idle", "runsCompleted" => 0, "menu" => null });
    return r.passed(logger);
}

