import Toybox.Lang;
import Toybox.Test;

// BACK steps back through the start-up screens and closes the app from the first (APP-5, REC-11)
(:test)
function scenario_app_back_steps_back(logger as Logger) as Boolean {
    var r = new ScenarioRunner(1700000000);
    r.press("up");
    r.press("start");
    r.press("start");
    r.expect({ "screen" => "recording" });
    r.press("back");
    r.expect({ "screen" => "ballSelect", "mode" => "record", "balls" => 3 });
    r.press("back");
    r.expect({ "screen" => "modeSelect", "recordMode" => true, "exits" => 0 });
    r.press("down");
    r.press("start");
    r.expect({ "screen" => "ballSelect", "mode" => "juggle" });
    r.press("back");
    r.expect({ "screen" => "modeSelect", "recordMode" => false });
    r.press("back");
    r.expect({ "exits" => 1 });
    return r.passed(logger);
}

