// BACK offers to discard the current or last run; Keep changes nothing (JUG-3, JUG-5)
(:test)
function scenario_jug_discard_runs(logger as Logger) as Boolean {
    var r = new ScenarioRunner(1700000000);
    r.press("start");
    r.press("start");
    r.warmup();
    r.catches(5);
    r.idle(60);
    r.catches(4);
    r.press("back");
    r.expect({ "menu" => "discard_run", "menuTitle" => "Discard this run?", "menuLabels" => ["Discard", "Keep"], "menuSubLabels" => ["4 catches", null] });
    r.select("discard_yes");
    r.expect({ "menu" => null, "count" => 0, "runs" => 1 });
    r.catches(3);
    r.idle(60);
    r.expect({ "runs" => 2 });
    r.press("back");
    r.expect({ "menuTitle" => "Discard last run?", "menuSubLabels" => ["3 catches", null] });
    r.select("discard_no");
    r.expect({ "runs" => 2 });
    r.press("back");
    r.press("back");
    r.expect({ "menu" => null, "runs" => 2 });
    r.press("back");
    r.select("discard_yes");
    r.expect({ "runs" => 1, "previous" => 5, "exits" => 0 });
    return r.passed(logger);
}

