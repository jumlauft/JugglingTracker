    r.warmup();
    r.expect({ "runActive" => false, "runs" => 0 });
    r.catches(3);
    r.expect({ "runActive" => true, "count" => 3 });
    r.idle(60);
    r.expect({ "runActive" => false, "count" => 0, "previous" => 3, "runs" => 1, "max" => 3 });
