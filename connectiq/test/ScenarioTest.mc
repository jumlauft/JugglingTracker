// Ending again after Continue resends the whole session under its first timestamp (SYNC-5)
(:test)
function scenario_sync_resend_after_continue(logger as Logger) as Boolean {
    var r = new ScenarioRunner(1700000000);
    r.press("start");
    r.press("start");
    r.warmup();
    r.catches(3);
    r.idle(60);
    r.press("start");
    r.select("sync_quit");
    r.wait(10000);
    r.select("continue_session");
    r.epochAdvance(120);
    r.catches(4);
    r.idle(60);
    r.press("start");
    r.select("sync_quit");
    r.expect({ "sentCount" => 2, "lastSent" => { "timestamp" => 1700000000, "runs" => [3, 4] } });
    r.phone({ "type" => "ack", "timestamp" => 1700000000 });
    r.expect({ "exits" => 1 });
    return r.passed(logger);
}

// Sync and quit sends the session once and closes only on the matching ack (SYNC-1, SYNC-2)
(:test)
function scenario_sync_session_and_ack(logger as Logger) as Boolean {
    var r = new ScenarioRunner(1700000000);
    r.press("start");
    r.press("start");
    r.warmup();
    r.catches(3);
    r.idle(60);
    r.catches(4);
    r.press("start");
    r.select("sync_quit");
    r.expect({ "sentTypes" => ["session"], "sentCount" => 1, "sending" => true, "lastSent" => { "type" => "session", "countMode" => "watch_hand", "balls" => 3, "timestamp" => 1700000000, "runs" => [3, 4] } });
    r.deliver(true);
    r.expect({ "exits" => 0, "sending" => true });
    r.phone({ "type" => "ack", "timestamp" => 1600000000 });
    r.expect({ "exits" => 0, "sending" => true });
    r.phone({ "type" => "ack" });
    r.expect({ "exits" => 0 });
    r.phone({ "type" => "ack", "timestamp" => 1700000000 });
    r.expect({ "exits" => 1 });
    return r.passed(logger);
}

// No ack in time opens the retry menu; Retry sends the same session again (SYNC-2, JUG-8)
(:test)
function scenario_sync_timeout_and_retry(logger as Logger) as Boolean {
    var r = new ScenarioRunner(1700000000);
    r.press("start");
    r.press("start");
    r.warmup();
    r.catches(3);
    r.idle(60);
    r.press("start");
    r.select("sync_quit");
    r.deliver(true);
    r.wait(10000);
    r.expect({ "sending" => false, "menu" => "session_end", "menuTitle" => "Sync failed", "menuItems" => ["sync_retry", "nosync_quit", "continue_session"], "menuLabels" => ["Retry sync", "Quit without sync", "Continue"] });
    r.select("sync_retry");
    r.expect({ "sentCount" => 2, "sending" => true, "menu" => null });
    r.phone({ "type" => "ack", "timestamp" => 1700000000 });
    r.expect({ "exits" => 1 });
    return r.passed(logger);
}
